# Notify Chain frontend environment example
#
# Copy this file to .env.local for local development. The values below are
# public browser-side configuration placeholders. Do not commit private keys,
# wallet seed phrases, API secrets, or production credentials.

# Next.js app URL used for local links and callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend/API endpoint used by frontend data fetching once live endpoints are wired.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# WebSocket endpoint for live notification and contract event updates.
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# Stellar/Soroban network configuration for local development.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Notify Chain Soroban contract id for the selected network.
NEXT_PUBLIC_NOTIFY_CHAIN_CONTRACT_ID=

# Optional wallet-kit project id, if the selected wallet module requires one.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
